# SYNCRIG 환경변수 템플릿
# 이 파일을 .env로 복사하여 실제 값을 입력하세요.

# ── JWT 보안 (필수 — Vercel Environment Variables에 설정) ──
JWT_SECRET=your_random_secret_key_here_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_key_here

# ── 데이터베이스 (Vercel Postgres 연결 시 자동 주입) ──
# DATABASE_URL=postgresql://user:password@host:5432/syncrig

# ── Steam Web API (선택 — 실제 게임 데이터 연동 시 필요) ──
# STEAM_API_KEY=your_steam_api_key

# ── 환경 구분 ──
# NODE_ENV=production
